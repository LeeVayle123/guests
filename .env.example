# Configuration Supabase / PostgreSQL pour le projet
# Remplacez les valeurs ci-dessous par vos accès Supabase

# Option 1 (Recommandée) : La chaîne de connexion globale Supabase (URI)
# Format : postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Option 2 : Variables séparées si vous préférez
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD=YOUR_PASSWORD

# Clé secrète de l'application Flask
SECRET_KEY=votre_cle_secrete_super_securisee
